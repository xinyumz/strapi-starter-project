# 🌍 Enterprise Multilingual CMS - Environment Configuration

# ============================================================================
# CORE STRAPI SETTINGS (REQUIRED)
# ============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=1337
NODE_ENV=development

# Security Keys (MUST CHANGE FOR PRODUCTION)
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified

# ============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================================================

# MySQL Configuration (recommended for production)
DATABASE_CLIENT=mysql2
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=multilingual_cms
DATABASE_USERNAME=your_db_user
DATABASE_PASSWORD=your_db_password

# Database Pool Settings (optional)
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=60000

# SSL Settings (for production)
DATABASE_SSL=false
# DATABASE_SSL_KEY=
# DATABASE_SSL_CERT=
# DATABASE_SSL_CA=

# ============================================================================
# GOOGLE CLOUD TRANSLATION (REQUIRED FOR TRANSLATION FEATURES)
# ============================================================================

# Path to your Google Cloud service account key file
# Download from: Google Cloud Console > IAM & Admin > Service Accounts
GOOGLE_APPLICATION_CREDENTIALS=./path/to/your-service-account-key.json

# Alternative: Google Cloud Project ID (if using other auth methods)
# GOOGLE_CLOUD_PROJECT_ID=your-project-id

# ============================================================================
# NEXT.JS INTEGRATION (OPTIONAL - FOR REVALIDATE PLUGIN)
# ============================================================================

# Next.js Application Settings
NEXTJS_REVALIDATE_URL=https://your-nextjs-app.com
NEXTJS_REVALIDATE_TOKEN=your-secret-revalidation-token

# Revalidation Behavior
REVALIDATE_ENABLED=true
REVALIDATE_RETRY_ATTEMPTS=3
REVALIDATE_RETRY_DELAY=5000
REVALIDATE_BATCH_SIZE=10
REVALIDATE_RATE_LIMIT=100
REVALIDATE_ENVIRONMENT=development
REVALIDATE_WEBHOOK_TIMEOUT=30000

# ============================================================================
# DEBUG SETTINGS (OPTIONAL)
# ============================================================================

# General Debug Logging
DEBUG=true
DEBUG_HEALTH=true
DEBUG_PLUGINS=true
DEBUG_CLEANUP=true
DEBUG_TRANSLATOR=true
DEBUG_REVALIDATE=true

# ============================================================================
# PERFORMANCE SETTINGS (OPTIONAL)
# ============================================================================

# Cache TTL Settings (in milliseconds)
HEALTH_CACHE_TTL=120000          # 2 minutes
ORPHAN_CACHE_TTL=300000          # 5 minutes  
DUPLICATE_CACHE_TTL=600000       # 10 minutes

# Translation Cache
TRANSLATOR_CACHE_TTL=86400000    # 24 hours
TRANSLATOR_RATE_LIMIT=1000       # Requests per minute
TRANSLATOR_RETRY_ATTEMPTS=3
TRANSLATOR_TIMEOUT=30000         # 30 seconds

# ============================================================================
# DUPLICATE DETECTION SETTINGS (OPTIONAL)
# ============================================================================

# Similarity thresholds for duplicate detection
DUPLICATE_SIMILARITY_THRESHOLD=0.8    # 80% similarity
TITLE_WEIGHT=0.6                      # Title importance in similarity
METADATA_WEIGHT=0.4                   # Metadata importance

# ============================================================================
# DEVELOPMENT SETTINGS (DEVELOPMENT ONLY)
# ============================================================================

# Plugin Development
PLUGIN_WATCH=true
AUTO_RELOAD=true

# Admin Panel
ADMIN_PATH=/admin

# ============================================================================
# PRODUCTION SETTINGS (PRODUCTION ONLY)
# ============================================================================

# When NODE_ENV=production, use these settings:
# DEBUG=false
# DEBUG_HEALTH=false  
# DEBUG_PLUGINS=false
# HEALTH_CACHE_TTL=300000    # 5 minutes
# ORPHAN_CACHE_TTL=600000    # 10 minutes
# DUPLICATE_CACHE_TTL=1800000 # 30 minutes