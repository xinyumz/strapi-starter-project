{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Title": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "Date": {
      "type": "date"
    },
    "Cover": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "Base": {
      "type": "text",
      "required": true
    },
    "Translation": {
      "type": "customField",
      "customField": "plugin::translator.translator"
    },
    "SelectCategory": {
      "type": "customField",
      "options": {
        "maxDepth": 2,
        "target": "Categories",
        "targetAttribute": "Name"
      },
      "customField": "plugin::categorizer.categorizer"
    },
    "Categories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::category.category",
      "mappedBy": "article"
    },
    "HSK": {
      "type": "customField",
      "customField": "plugin::article-enhancer.hsk-calculator"
    },
    "Grammar": {
      "type": "customField",
      "customField": "plugin::article-enhancer.grammar-rules"
    },
    "AccessTier": {
      "type": "enumeration",
      "enum": [
        "Free",
        "Login",
        "Premium"
      ],
      "required": true,
      "default": "Free"
    }
  }
}
